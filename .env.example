# Local secrets belong in ignored .env.qa; CI uses injected secrets.
# Fill only the services/accounts you use. Never commit populated values.
# Browser settings and test selection belong in playwright.config.js or CLI flags.

ACCOUNT_APPROVED_MONITOR_USERNAME=
ACCOUNT_APPROVED_MONITOR_PASSWORD=
ACCOUNT_SECONDARY_USERNAME=
ACCOUNT_SECONDARY_PASSWORD=

# Optional explicit local AI (OpenAI or Azure Anthropic-compatible routing).
OPENAI_API_KEY=
AZURE_ANTHROPIC_ENDPOINT=
AZURE_ANTHROPIC_API_KEY=
AZURE_ANTHROPIC_MODEL=

# Optional LambdaTest cloud execution.
LT_USERNAME=
LT_ACCESS_KEY=

# Optional explicit Slack notification command.
SLACK_WEBHOOK_URL=
